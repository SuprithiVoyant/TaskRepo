<!DOCTYPE html>
<html>
<head>
<meta charset="ISO-8859-1">
<title>Add Record</title>
</head>
<body>
    <h1>Add Employee Record</h1>
    <form action="add" method="post">
        Name: <input type="text" name="name" required><br>
